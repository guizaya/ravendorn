{
  "name": "rpg-2d-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n WEB,API -c cyan,magenta \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:server": "node --env-file-if-exists=.env --watch --watch-path=server/src server/src/index.js",
    "dev:server:tudo": "node --env-file-if-exists=.env --watch server/src/index.js",
"start": "node --env-file-if-exists=.env server/src/index.js",
    "build": "vite build --mode production",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "test": "vitest run",
    "sprites:arbalist": "node tools/gif-to-sheet.mjs",
    "sprites:warrior": "node tools/gif-to-sheet.mjs warrior",
    "sprites:sorcerer": "node tools/gif-to-sheet.mjs sorcerer",
    "sprites:lancer": "node tools/gif-to-sheet.mjs lancer",
    "sprites:rato": "node tools/gif-to-sheet.mjs rato_da_toca",
    "sprites:sentinela": "node tools/gif-to-sheet.mjs sentinela_esqueletica",
    "sprites:limo": "node tools/gif-to-sheet.mjs limo_preguicoso",
    "sprites:goblin": "node tools/gif-to-sheet.mjs goblin_saqueador",
    "props:arvore": "node tools/gerar-arvore-prop.mjs"
  },
  "dependencies": {
    "ethers": "^6.17.0",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "jsdom": "^25.0.1",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
